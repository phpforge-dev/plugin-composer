{
  "id": "phpforge.composer",
  "name": "Composer",
  "version": "1.1.0",
  "minIdeVersion": "0.2.19",
  "description": "Composer: separate Rust tool service and workbench integration.",
  "main": "main.js",
  "activation": {
    "languages": [
      "php",
      "json"
    ],
    "files": []
  },
  "permissions": [
    "project.read",
    "native.tool",
    "workbench"
  ],
  "tool": {
    "protocolVersion": 1,
    "methods": [
      "composerRun",
      "composerCancel",
      "composerProbe",
      "composerCheck",
      "composerSearch",
      "composerVersions"
    ],
    "event": "composer-progress",
    "workbench": "workbench.js",
    "style": "workbench.css",
    "binaries": {
      "aarch64-macos": {
        "path": "bin/aarch64-macos/phpforge-composer",
        "sha256": "3a7d19922a05d7efb66288ece87dec59a273d28fa4864f203caf3934f06ebb3c"
      },
      "x86_64-linux": {
        "path": "bin/x86_64-linux/phpforge-composer",
        "sha256": "8f75edf11c98037eb4cc0c740b367e04730293184a75410c77c16b158cca2c4b"
      },
      "x86_64-windows": {
        "path": "bin/x86_64-windows/phpforge-composer.exe",
        "sha256": "177aed5d05c3dd01d0b677b00c853a65353d667abf4c82c7a03a55519bfea40e"
      }
    }
  }
}
