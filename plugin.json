{
  "id": "phpforge.composer",
  "name": "Composer",
  "version": "1.0.0",
  "minIdeVersion": "0.2.11",
  "description": "Composer: separate Rust tool service and workbench integration.",
  "main": "main.js",
  "activation": {
    "languages": [
      "php",
      "json"
    ],
    "files": []
  },
  "permissions": [
    "project.read",
    "native.tool",
    "workbench"
  ],
  "tool": {
    "protocolVersion": 1,
    "methods": [
      "composerRun",
      "composerCancel",
      "composerProbe",
      "composerSearch",
      "composerVersions"
    ],
    "event": "composer-progress",
    "workbench": "workbench.js",
    "style": "workbench.css",
    "binaries": {
      "aarch64-macos": {
        "path": "bin/aarch64-macos/phpforge-composer",
        "sha256": "8e9765b4e7d3124cae0f32aaf232fd47f15c86d2e028c3890307dc37e32f8949"
      },
      "x86_64-linux": {
        "path": "bin/x86_64-linux/phpforge-composer",
        "sha256": "85a2a8a9f663eeab8c69914d7e46c5a231ff39fffca58b46330556a10020a956"
      },
      "x86_64-windows": {
        "path": "bin/x86_64-windows/phpforge-composer.exe",
        "sha256": "9368af7b2dbf0e8eccf8c473685f1a29da83044c968daa943f0a80250248b90b"
      }
    }
  }
}
