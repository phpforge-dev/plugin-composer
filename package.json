{
  "name": "@phpforge/plugin-composer",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "cargo test --manifest-path native/Cargo.toml && node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/window.mjs",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
